     "documentation": "OPCIONAL. Busca perfiles públicos (LinkedIn, X, Instagram, Facebook, TikTok,\nYouTube, GitHub, Medium) de una persona vinculada a la empresa investigada,\ncon búsquedas `site:` en el SearXNG local (yandex/seznam; SEARXNG_URL) y la\nAPI de GitHub; Google vía Apify si usar_apify=true. No entra en las redes.\nEl nombre debe aparecer en el título del resultado; la empresa o el dominio\nsuben la confianza. Sin empresa vinculada no hace nada.",
     "description": "[PERFILES] Public social profiles of a company-linked person (opt-in).",
     "required_params": false,
     "params": {},
     "params_schema": [
      {
       "name": "empresa",
       "type": "string",
       "required": false,
       "description": "Empresa vinculada. Si se omite se usa la Organization vecina; sin empresa no se busca."
      },
      {
       "name": "redes",
       "type": "string",
       "default": "linkedin,x,instagram,facebook,tiktok,youtube,github,medium",
       "required": false,
       "description": "Redes a buscar, separadas por comas."
      },
      {
       "name": "min_confianza",
       "type": "string",
       "default": "0.6",
       "required": false,
       "description": "Confianza mínima (0-1)."
      },
      {
       "name": "usar_apify",
       "type": "string",
       "default": "false",
       "required": false,
       "description": "Añadir Google vía Apify (de pago, ~0,005 $ por consulta)."
      },
      {
       "name": "APIFY_TOKEN",
       "type": "vaultSecret",
       "required": false,
       "description": "Solo si usar_apify=true (si no está en la vault se usa la variable de entorno)."
      }
     ],
     "icon": null,
