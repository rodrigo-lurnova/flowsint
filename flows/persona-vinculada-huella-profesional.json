       "type": "string",
       "required": false,
       "description": "Fecha inicial AAAA-MM-DD."
      },
      {
       "name": "HASTA",
       "type": "string",
       "required": false,
       "description": "Fecha final AAAA-MM-DD."
      },
      {
       "name": "PROVINCIA",
       "type": "string",
       "required": false,
       "description": "Provincias separadas por comas (nombre o código INE) para abaratar."
      },
      {
       "name": "MAX_PETICIONES",
       "type": "string",
       "default": "1500",
       "required": false,
       "description": "Tope de peticiones a boe.es por ejecución."
      }
